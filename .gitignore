# Local working files: research notes, references, and the scratch data directory. The published transcripts live in
# inputs/, the gold material in gold/, and every run's outputs in results/.
/analysis/
/sources/
/data/
/references/
ponytail-reference/
ponytail-references/
*.docx
*.DOCX
!/inputs/*.docx

# Credentials and local configuration (keep example files shareable)
.env
.env.*
!.env.example
!.env.*.example

# Python environments and generated caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Frontend dependencies and build output; the data bundle in web/src/data/ is tracked so a clone runs as is
node_modules/
.next/
dist/
*.tsbuildinfo

# Local machine files
.DS_Store
*.log

# Local planning drafts, kept out of Git until reviewed
/MVP-BUILD-BRIEF.md
/BUILD-TEST-ROADMAP.md
